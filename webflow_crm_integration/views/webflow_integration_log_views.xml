<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_webflow_log_list" model="ir.ui.view">
        <field name="name">webflow.integration.log.list</field>
        <field name="model">webflow.integration.log</field>
        <field name="arch" type="xml">
            <list string="Webflow Logs" decoration-success="state=='success'"
                  decoration-danger="state=='failed'" decoration-muted="state=='skipped'">
                <field name="create_date" string="Date"/>
                <field name="webflow_event"/>
                <field name="form_name"/>
                <field name="state" widget="badge"
                       decoration-success="state=='success'"
                       decoration-danger="state=='failed'"
                       decoration-warning="state=='skipped'"/>
                <field name="http_status"/>
                <field name="lead_id"/>
                <field name="processing_time"/>
                <field name="retry_count"/>
                <field name="ip_address" optional="hide"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <button name="action_retry" type="object" string="Retry"
                        icon="fa-refresh" invisible="state == 'success'"/>
            </list>
        </field>
    </record>

    <record id="view_webflow_log_form" model="ir.ui.view">
        <field name="name">webflow.integration.log.form</field>
        <field name="model">webflow.integration.log</field>
        <field name="arch" type="xml">
            <form string="Webflow Log">
                <header>
                    <button name="action_retry" type="object" string="Retry Import"
                            class="btn-primary" invisible="state == 'success'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="success,failed,skipped"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="webflow_event"/>
                            <field name="form_name"/>
                            <field name="lead_id"/>
                            <field name="http_status"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="processing_time"/>
                            <field name="retry_count"/>
                            <field name="ip_address"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_webflow_log_search" model="ir.ui.view">
        <field name="name">webflow.integration.log.search</field>
        <field name="model">webflow.integration.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="form_name"/>
                <field name="lead_id"/>
                <field name="ip_address"/>
                <filter name="success" string="Success" domain="[('state', '=', 'success')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_form" string="Form" context="{'group_by': 'form_name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_webflow_log" model="ir.actions.act_window">
        <field name="name">Integration Logs</field>
        <field name="res_model">webflow.integration.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_webflow_log_search"/>
        <field name="context">{'search_default_failed': 0}</field>
    </record>
</odoo>
