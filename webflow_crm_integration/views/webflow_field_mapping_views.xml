<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_webflow_mapping_list" model="ir.ui.view">
        <field name="name">webflow.field.mapping.list</field>
        <field name="model">webflow.field.mapping</field>
        <field name="arch" type="xml">
            <list string="Field Mappings" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="webflow_field"/>
                <field name="odoo_field"/>
                <field name="mapping_type"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_webflow_mapping_form" model="ir.ui.view">
        <field name="name">webflow.field.mapping.form</field>
        <field name="model">webflow.field.mapping</field>
        <field name="arch" type="xml">
            <form string="Field Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="webflow_field"/>
                            <field name="odoo_field"/>
                            <field name="mapping_type"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webflow_mapping" model="ir.actions.act_window">
        <field name="name">Field Mappings</field>
        <field name="res_model">webflow.field.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define how Webflow form fields map to CRM lead fields.</p>
            <p>Each row maps an incoming Webflow field name to a field on the CRM lead.</p>
        </field>
    </record>
</odoo>
