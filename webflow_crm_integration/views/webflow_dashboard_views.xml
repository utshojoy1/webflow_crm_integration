<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_webflow_dashboard_form" model="ir.ui.view">
        <field name="name">webflow.dashboard.form</field>
        <field name="model">webflow.dashboard</field>
        <field name="arch" type="xml">
            <form string="Webflow Dashboard" create="false" edit="false">
                <header>
                    <button name="action_refresh" type="object" string="Refresh"
                            class="btn-primary" icon="fa-refresh"/>
                    <button name="action_view_logs" type="object" string="All Logs"
                            icon="fa-list"/>
                    <button name="action_view_failed" type="object" string="Failed Only"
                            class="btn-secondary" icon="fa-exclamation-triangle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Webflow Integration Dashboard</h1>
                    </div>
                    <group>
                        <group string="Webhook Volume">
                            <field name="total_webhooks"/>
                            <field name="successful_imports"/>
                            <field name="failed_imports"/>
                            <field name="skipped_imports"/>
                        </group>
                        <group string="Health">
                            <field name="success_rate"/>
                            <field name="health_status" widget="badge"
                                   decoration-success="health_status=='ok'"
                                   decoration-warning="health_status=='warning'"
                                   decoration-danger="health_status=='error'"
                                   decoration-muted="health_status=='idle'"/>
                            <field name="todays_leads"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_webflow_dashboard" model="ir.actions.act_window">
        <field name="name">Dashboard</field>
        <field name="res_model">webflow.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="view_id" ref="view_webflow_dashboard_form"/>
    </record>
</odoo>
