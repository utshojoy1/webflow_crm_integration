<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_webflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.webflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Webflow" string="Webflow" name="webflow_crm_integration"
                     logo="/webflow_crm_integration/static/description/icon.svg">
                    <block title="General" name="webflow_general">
                        <setting id="webflow_enabled_setting"
                                 title="Enable the Webflow CRM webhook integration.">
                            <field name="webflow_enabled"/>
                            <div class="text-muted">Enable Webflow Integration</div>
                        </setting>
                        <setting string="Defaults" help="Defaults applied to every imported lead"
                                 invisible="not webflow_enabled">
                            <div class="content-group mt16">
                                <div class="row mb-2" groups="base.group_multi_company">
                                    <label string="Companies" for="webflow_company_ids"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_company_ids" widget="many2many_tags"
                                           help="Companies this integration serves. New leads are created in the first company."/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Default Sales Team" for="webflow_team_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_team_id"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Default Salesperson" for="webflow_user_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_user_id"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Default Lead Stage" for="webflow_stage_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_stage_id"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Default Lead Source" for="webflow_source_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_source_id"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Default Tags" for="webflow_tag_ids"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_tag_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Duplicate Detection"
                                 help="Detect and handle duplicate leads by email/phone"
                                 invisible="not webflow_enabled">
                            <field name="webflow_duplicate_detection"/>
                            <div class="content-group mt16"
                                 invisible="not webflow_duplicate_detection">
                                <field name="webflow_duplicate_strategy"/>
                            </div>
                        </setting>
                    </block>

                    <block title="Webflow Credentials" name="webflow_credentials"
                           invisible="not webflow_enabled">
                        <setting string="API Credentials"
                                 help="Stored securely via ir.config_parameter">
                            <div class="content-group">
                                <div class="row mb-2">
                                    <label string="Webflow API Token" for="webflow_api_token"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_api_token" password="True"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Site ID" for="webflow_site_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_site_id"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Workspace ID" for="webflow_workspace_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_workspace_id"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Collection ID" for="webflow_collection_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_collection_id"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Form ID" for="webflow_form_id"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_form_id"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="API Version" for="webflow_api_version"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_api_version"/>
                                </div>
                            </div>
                            <div class="mt8">
                                <button name="action_webflow_test_api" type="object"
                                        string="Test Webflow API" class="btn-secondary"
                                        icon="fa-plug"/>
                                <button name="action_webflow_open_docs" type="object"
                                        string="Open Documentation" class="btn-link"
                                        icon="fa-book"/>
                            </div>
                        </setting>
                    </block>

                    <block title="Webhook Endpoint" name="webflow_webhook"
                           invisible="not webflow_enabled">
                        <setting string="Webhook URL"
                                 help="Paste this URL into your Webflow webhook settings">
                            <div class="content-group">
                                <div class="row mb-2">
                                    <label string="Webhook URL" for="webflow_webhook_url"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_webhook_url" readonly="1"
                                           widget="CopyClipboardChar"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Webhook Secret" for="webflow_webhook_secret"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_webhook_secret"
                                           widget="CopyClipboardChar" password="True"/>
                                </div>
                                <div class="row mb-2">
                                    <label string="Require HMAC Signature" for="webflow_require_hmac"
                                           class="col-lg-5 o_light_label"/>
                                    <field name="webflow_require_hmac"/>
                                </div>
                            </div>
                            <div class="mt16">
                                <h5 class="mb-1">Automatic setup</h5>
                                <div class="text-muted mb-2">
                                    Uses your API token (with webhook scope) to create the
                                    Form Submission webhook in Webflow — URL and secret included.
                                    Turn off "Require HMAC Signature" for this query-string secret method.
                                </div>
                                <div class="mb-3">
                                    <button name="%(action_webflow_connection_wizard)d" type="action"
                                            string="Open Setup Wizard"
                                            class="btn-secondary me-2 mb-2" icon="fa-magic"/>
                                    <button name="action_webflow_register_webhook" type="object"
                                            string="Register Webhook in Webflow"
                                            class="btn-primary me-2 mb-2" icon="fa-cloud-upload"/>
                                    <button name="action_webflow_list_webhooks" type="object"
                                            string="Verify / List Webhooks"
                                            class="btn-secondary me-2 mb-2" icon="fa-list-ul"/>
                                </div>
                                <h5 class="mb-1">Manual setup &amp; utilities</h5>
                                <div>
                                    <button name="action_webflow_regenerate_secret" type="object"
                                            string="Regenerate Secret"
                                            class="btn-secondary me-2 mb-2" icon="fa-refresh"/>
                                    <button name="action_webflow_send_test_webhook" type="object"
                                            string="Send Test Webhook"
                                            class="btn-secondary me-2 mb-2" icon="fa-paper-plane"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Notifications" name="webflow_notifications"
                           invisible="not webflow_enabled">
                        <setting help="Subscribe and notify the assigned salesperson">
                            <field name="webflow_notify_salesperson"/>
                            <div class="text-muted">Notify Salesperson</div>
                        </setting>
                        <setting help="Create a follow-up activity on each new lead">
                            <field name="webflow_create_activity"/>
                            <div class="text-muted">Create Activity</div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_webflow_config_settings" model="ir.actions.act_window">
        <field name="name">Webflow Integration</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'webflow_crm_integration'}</field>
    </record>
</odoo>
