<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups are defined with only fields that exist on res.groups in both
         Odoo 18 and 19. Odoo 19 removed res.groups.category_id (categories now
         live on res.groups.privilege), so we intentionally omit it. -->
    <record id="group_webflow_user" model="res.groups">
        <field name="name">Webflow: User</field>
    </record>

    <record id="group_webflow_manager" model="res.groups">
        <field name="name">Webflow: Administrator</field>
        <field name="implied_ids" eval="[(4, ref('group_webflow_user'))]"/>
    </record>

    <!-- System administrators are Webflow administrators by default. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_webflow_manager'))]"/>
    </record>

    <!-- Multi-company record rule on the integration logs. -->
    <record id="rule_webflow_log_company" model="ir.rule">
        <field name="name">Webflow Log: multi-company</field>
        <field name="model_id" ref="model_webflow_integration_log"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_webflow_mapping_company" model="ir.rule">
        <field name="name">Webflow Mapping: multi-company</field>
        <field name="model_id" ref="model_webflow_field_mapping"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
